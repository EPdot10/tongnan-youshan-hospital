{
  "name": "tongnan-youshan-hospital",
  "version": "0.1.0",
  "private": true,
  "description": "重庆潼南友善阳光中医医院 官网（第一版 · 演示）",
  "scripts": {
    "dev": "next dev",
    "images": "node scripts/fetch-images.mjs",
    "build": "node scripts/fetch-images.mjs && next build && node scripts/postbuild.mjs",
    "build:offline": "next build && node scripts/postbuild.mjs",
    "start": "npx serve@latest out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run build:offline"
  },
  "browserslist": [
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "safari >= 14",
    "ios_saf >= 14"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.164.0"
  }
}
